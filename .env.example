# 複製成根目錄 .env 後填值（`cp .env.example .env`）。完整說明見 deploy/SETUP.md。

# === 必填 ===
# 產生：python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY='change-me'
DATABASE_PASSWORD='change-me'
# 隱藏 /admin/ 的繞過金鑰（高強度隨機值；留空則停用繞過）
ADMIN_ACCESS_KEY='change-me'

# === 部署（內網單機）===
DEBUG=False
ALLOWED_HOSTS=192.168.1.50
INSTANCE_BIND_HOST=192.168.1.50
INSTANCE_PUBLIC_HOST=192.168.1.50

# 內網純 HTTP：關掉 https 強制與 Secure cookie，否則 admin 登不進去
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
CSRF_TRUSTED_ORIGINS=http://192.168.1.50
CORS_ALLOWED_ORIGINS=http://192.168.1.50

# === 選用 ===
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=25000
# ACTIVEINSTANCE_LIMIT=30
# INSTANCE_EXPIRY_MINUTES=30
# SENTRY_DSN=
# PAGE_SIZE=20
# 登入端點的 IP 節流（axes 只鎖單一帳號，這條擋輪換帳號的暴力嘗試）
# THROTTLE_LOGIN=30/min
# 靶機容器強制丟掉的危險 capabilities（預設已含 NET_RAW/SYS_ADMIN… 擋跳板/逃逸）。
# 換自己的鏡像若啟動失敗再調整；要最嚴可設 ALL 並用 INSTANCE_CAP_ADD 加回最小集合。
# INSTANCE_CAP_DROP=NET_RAW,NET_ADMIN,SYS_ADMIN,SYS_PTRACE,DAC_READ_SEARCH,MKNOD
# INSTANCE_CAP_ADD=
# 靶機編排指令：預設 v2（docker compose）。舊 v1-only 主機才改：
# DOCKER_COMPOSE_CMD=docker-compose
# nginx 前面有幾層代理（DRF 節流取真實 client IP 用，單層 nginx=1）：
# NUM_PROXIES=1

# 本機開發時改成：
# DEBUG=True
# （DEBUG=True 時上面的安全/內網設定可全部省略）
